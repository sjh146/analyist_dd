# ===========================================
# Example environment configuration
# Copy to .env and replace with actual values
# ===========================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stock_trading
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=your_postgres_password_here

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# LLM 엔드포인트 전환용 — 로컬 llama-server 등으로 바꾸면 DeepSeek 대신 로컬 추론
LLM_BASE_URL=https://api.deepseek.com
# 로컬 LLM 서버(LLM_BASE_URL 전환 시)에서 사용할 모델명. 비워두면 DEEPSEEK_MODEL 사용.
LLM_MODEL=

# GPU 준비용 (GPU 없어도 기본값 그대로 CPU 동작)
# EMBEDDING_DEVICE: auto | cuda | cpu | mps
#   auto = torch.cuda.is_available() 이면 cuda, 아니면 cpu (기본값)
#   cuda 를 명시했는데 사용 불가하면 경고 후 cpu 폴백
EMBEDDING_DEVICE=auto
# 임베딩 인코딩 배치 크기
EMBEDDING_BATCH_SIZE=32
# CPU 임베딩 스레드 수 튜닝용 (기본 미설정 = torch 기본 동작 유지)
# 양의 정수만 유효. 경합(다른 컨테이너 CPU 점유) 중 스레드 증가는 역효과 주의.
# 유휴 상태에서 scripts/embed_bench.py 로 재측정 후 결정.
# EMBEDDING_TORCH_THREADS=1

# Proxmox Bridge (Windows VM)
BRIDGE_VM_IP=192.168.1.101
BRIDGE_VM_PORT=6379

# Trading
TRADING_START_HOUR=9
TRADING_END_HOUR=15
MAX_POSITION_SIZE=10000000
MAX_DAILY_TRADE=50000000

# ML
ML_MODEL_VERSION=v1.0
VECTOR_DIMENSION=1024

# DART OpenAPI (Financial Statements & Disclosures)
DART_API_KEY=your_dart_api_key_here

# Bank of Korea ECOS API (Macro-economic indicators)
ECOS_API_KEY=your_ecos_api_key_here

# Data Collection Intervals
MACRO_UPDATE_INTERVAL_HOURS=24
COMPANY_DATA_UPDATE_INTERVAL_DAYS=90

# Feature Engineering
FEATURE_CACHE_TTL_SECONDS=3600
MAX_STOCKS_TO_TRACK=500

# Logging
LOG_LEVEL=INFO

# Security (Strix CWE-798/306)
TRADE_SIGNAL_SECRET=change-me-strong-random-32-bytes-min
GF_ADMIN_PASSWORD=change-me-grafana-admin-password
JENKINS_ADMIN_PASSWORD=
