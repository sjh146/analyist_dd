# ===========================================
# analyist_dd 환경 설정 템플릿
#   cp .env.example .env  후 실제 값으로 교체하라.
#   .env 는 .gitignore 로 차단돼 있다 — 절대 커밋하지 않는다.
#   필수(MUST) 표시가 있는 키가 비어 있으면 해당 컨테이너가 조용히 실패한다.
# ===========================================

# ---------- PostgreSQL ----------
# 컨테이너 내부에서는 서비스명(postgres), 호스트 스크립트에서는 127.0.0.1 + POSTGRES_HOST_PORT 를 쓴다.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# 호스트에 노출할 포트(기본 5434 — 5432 는 다른 DB 와 충돌이 잦다)
POSTGRES_HOST_PORT=5434
POSTGRES_DB=stock_trading
POSTGRES_USER=stock_user
POSTGRES_PASSWORD=your_postgres_password_here          # MUST

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here                 # MUST

# ---------- Neo4j (선택) ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ---------- LLM ----------
DEEPSEEK_API_KEY=your_deepseek_api_key_here             # MUST (뉴스/감성 피처)
DEEPSEEK_MODEL=deepseek-chat
# 로컬 llama-server 등으로 바꾸면 DeepSeek 대신 로컬 추론
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=

# ---------- GPU/임베딩 (GPU 없어도 CPU 로 동작) ----------
# auto | cuda | cpu | mps   (auto = cuda 가능하면 cuda)
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
# CPU 임베딩 스레드 수 (미설정 = torch 기본). 경합 중에는 증가가 역효과.
# EMBEDDING_TORCH_THREADS=1

# ---------- 한국투자증권 KIS OpenAPI ----------
# 발급: https://apiportal.koreainvestment.com  (실전/모의 각각 키가 다르다)
KIS_APP_KEY=your_kis_app_key_here                       # MUST (시세·수급 수집)
KIS_APP_SECRET=your_kis_app_secret_here                 # MUST
# 계좌번호(앞 8자리-뒤 2자리 형태). 모의투자 계좌를 권장.
KIS_ACCOUNT_NO=your_kis_account_no_here                 # MUST (주문 경로)
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_DAILY_TR_ID=FHKST03010100
KIS_MINUTE_TR_ID=FHKST03010200
# 호출 제한 준수: 3.0초 + 0.5초 지터 (분당 토큰 발급 1회 제한도 있음)
KIS_REQUEST_DELAY=3.0
KIS_REQUEST_JITTER=0.5
KIS_TOKEN_PATH=data/kis/token_cache.json

# ---------- DART (공시·재무) ----------
# 발급: https://opendart.fss.or.kr  — 공시 접수일(rcept_dt)과 재무제표 원천
DART_API_KEY=your_dart_api_key_here                     # MUST (재무 피처)

# ---------- 한국은행 ECOS (매크로) ----------
# 발급: https://ecos.bok.or.kr
ECOS_API_KEY=your_ecos_api_key_here

# ---------- KRX OpenAPI (공매도·파생) ----------
# 발급: https://openapi.krx.co.kr — 계정별로 미승인 서비스가 있다(투자자별 거래실적 등)
KRX_API_KEY=your_krx_api_key_here

# ---------- 내부 보안 (컨테이너 간 통신) ----------
# 32바이트 이상 랜덤 문자열 권장. 비어 있으면 게이트웨이가 무인증 모드로 뜬다.
INTERNAL_API_KEY=change-me-internal-api-key             # MUST
API_GATEWAY_KEY=change-me-api-gateway-key               # MUST
TRADE_SIGNAL_SECRET=change-me-strong-random-32-bytes-min
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ---------- 대시보드/CI ----------
GF_ADMIN_PASSWORD=change-me-grafana-admin-password      # Grafana admin
JENKINS_ADMIN_PASSWORD=

# ---------- 브리지(Windows 트레이딩 브리지) ----------
BRIDGE_VM_IP=192.168.1.101
BRIDGE_VM_PORT=6379

# ---------- 트레이딩 파라미터 ----------
TRADING_START_HOUR=9
TRADING_END_HOUR=15
MAX_POSITION_SIZE=10000000
MAX_DAILY_TRADE=50000000

# ---------- ML/피처 ----------
ML_MODEL_VERSION=v1.0
VECTOR_DIMENSION=1024
FEATURE_CACHE_TTL_SECONDS=3600
MAX_STOCKS_TO_TRACK=500

# ---------- 수집 주기 ----------
MACRO_UPDATE_INTERVAL_HOURS=24
COMPANY_DATA_UPDATE_INTERVAL_DAYS=90

# ---------- 로깅 ----------
LOG_LEVEL=INFO
