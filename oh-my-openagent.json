{
  "plugins": [
    {
      "name": "pontail",
      "port": 3030,
      "routes": ["/plans", "/evidence", "/status"],
      "enabled": true
    }
  ],
  "commands": {
    "monitor": "bash scripts/agent_monitor.sh",
    "pontail": "bash scripts/pontail_setup.sh",
    "cleanup-zombies": "bash scripts/cleanup_zombies.sh"
  },
  "model": "deepseek/deepseek-v4-flash",
  "provider": "deepseek",
  "agents": {
    "build": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "plan": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "sisyphus": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "hephaestus": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "sisyphus-junior": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "OpenCode-Builder": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "prometheus": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "metis": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "momus": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "oracle": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "librarian": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "explore": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "multimodal-looker": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] },
    "atlas": { "model": "deepseek/deepseek-v4-flash", "fallback_models": ["deepseek/deepseek-v4-pro"] }
  },
  "categories": {
    "deep": { "model": "deepseek/deepseek-v4-flash", "provider": "deepseek" },
    "quick": { "model": "deepseek/deepseek-v4-flash", "provider": "deepseek" },
    "unspecified-low": { "model": "deepseek/deepseek-v4-flash", "provider": "deepseek" },
    "unspecified-high": { "model": "deepseek/deepseek-v4-flash", "provider": "deepseek" },
    "writing": { "model": "deepseek/deepseek-v4-flash", "provider": "deepseek" }
  },
  "subagents": {
    "oracle": { "model": "deepseek/deepseek-v4-flash", "provider": "deepseek" },
    "momus": { "model": "deepseek/deepseek-v4-flash", "provider": "deepseek" },
    "metis": { "model": "deepseek/deepseek-v4-flash", "provider": "deepseek" },
    "explore": { "model": "deepseek/deepseek-v4-flash", "provider": "deepseek" },
    "librarian": { "model": "deepseek/deepseek-v4-flash", "provider": "deepseek" }
  }
}
