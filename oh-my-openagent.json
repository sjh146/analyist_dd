{
  "plugins": [
    {
      "name": "pontail",
      "port": 3030,
      "routes": ["/plans", "/evidence", "/status"],
      "enabled": true
    }
  ],
  "commands": {
    "monitor": "bash scripts/agent_monitor.sh",
    "pontail": "bash scripts/pontail_setup.sh",
    "cleanup-zombies": "bash scripts/cleanup_zombies.sh"
  },
  "model": "deepseek-chat",
  "provider": "deepseek",
  "categories": {
    "deep": { "model": "deepseek-chat", "provider": "deepseek" },
    "quick": { "model": "deepseek-chat", "provider": "deepseek" },
    "unspecified-low": { "model": "deepseek-chat", "provider": "deepseek" },
    "unspecified-high": { "model": "deepseek-chat", "provider": "deepseek" },
    "writing": { "model": "deepseek-chat", "provider": "deepseek" }
  },
  "subagents": {
    "oracle": { "model": "deepseek-chat", "provider": "deepseek" },
    "momus": { "model": "deepseek-chat", "provider": "deepseek" },
    "metis": { "model": "deepseek-chat", "provider": "deepseek" },
    "explore": { "model": "deepseek-chat", "provider": "deepseek" },
    "librarian": { "model": "deepseek-chat", "provider": "deepseek" }
  }
}
