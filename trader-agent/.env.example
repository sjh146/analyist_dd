# trader-agent 환경변수 템플릿 (cp .env.example .env)
#   - 값은 셸 환경변수로 export 하거나, runner/브리지 기동 스크립트에서 set 한다.
#   - 이름 규칙: TRADER_CORE_<필드> = trader-core(위험·피드·경로), RUNNER_<필드> = 루프(주기·게이트)
#   - 같은 이름이 양쪽에 있으면 RUNNER_* 가 이긴다. CLI > env > 파일(--config) > 프리셋 > 기본값.
#   - 필수는 없지만, 아래 4개는 운영에서 사실상 필수다(브리지 주소/피드/한도/상태파일).

# ---------- 연결 ----------
# Creon 브리지(32bit run_bridge.py) 주소. 다른 PC에서 브리지를 돌리면 그 IP.
TRADER_CORE_BRIDGE_BASE_URL=http://127.0.0.1:8100
# analyist_dd 피드. 피드가 없으면 feed_source=rank (Creon 랭킹)로 대체.
TRADER_CORE_FEED_URL=http://127.0.0.1:8090/screener_latest.json
# TRADER_CORE_FEED_SOURCE=rank
TRADER_CORE_FEED_MAX_AGE=86400
TRADER_CORE_REQUEST_TIMEOUT=5

# ---------- 위험 한도 (프리셋 paper_safe 값) ----------
TRADER_CORE_DRY_RUN=true
TRADER_CORE_SIZING_MODE=kelly
TRADER_CORE_KELLY_CAP=0.25
TRADER_CORE_KELLY_FRACTION=0.25
TRADER_CORE_RISK_PER_TRADE_PCT=0.005
TRADER_CORE_MAX_INVESTED_PCT=0.30
TRADER_CORE_MAX_POSITION_PCT=0.10
TRADER_CORE_MAX_OPEN_POSITIONS=3
# 경로별 슬롯(JSON). 합계가 전역 상한을 넘으면 전역이 이긴다.
TRADER_CORE_MAX_OPEN_POSITIONS_BY_SCREENER={"swing": 2, "daytrading": 1}
TRADER_CORE_DAILY_MAX_TRADES=3
TRADER_CORE_MAX_ORDER_AMOUNT=10000000
TRADER_CORE_STOP_LOSS_PCT=0.07
TRADER_CORE_TAKE_PROFIT_PCT=0.07
TRADER_CORE_TRAILING_ARM_PCT=0.055
TRADER_CORE_TRAILING_STOP_PCT=0.05
TRADER_CORE_MAX_STOP_PCT=0.20

# ---------- 시장 시간 (KST) ----------
TRADER_CORE_MARKET_OPEN=09:00
TRADER_CORE_MARKET_CLOSE=15:30
TRADER_CORE_MARKET_HOURS_ONLY=true

# ---------- 경로 ----------
# 상태/저널/킬스위치는 상대경로면 저장소 루트 기준이다.
RUNNER_STATE_PATH=loop_state.json
TRADER_CORE_JOURNAL_PATH=journal/trade_journal.sqlite3
TRADER_CORE_KILL_SWITCH_PATH=kill_switch.txt
RUNNER_PARAMS_PATH=strategy_params.json

# ---------- 루프 ----------
RUNNER_INTERVAL_SECONDS=300
RUNNER_DRY_RUN=true
RUNNER_MAX_CONSECUTIVE_CHECK_FAILURES=3
RUNNER_AUTO_RESUME_CHECK_HALT=true
# 뉴스 게이트(analyist_dd 선택 기능). 없으면 비워 둔다 — 켜져 있는데 도달 불가면
# fail-closed 로 모든 진입이 막힌다.
RUNNER_NEWS_GATE_URL=
RUNNER_NEWS_GATE_FAIL_CLOSED=true
# Discord 알림(선택). 비우면 로그만.
RUNNER_WEBHOOK_URL=

# ---------- 참고 ----------
# analyist_dd(리눅스 쪽)는 자체 .env 를 쓴다: POSTGRES/REDIS 비밀번호, KIS_APP_KEY/SECRET,
# DART_API_KEY, (선택) KRX_API_KEY·ECOS_API_KEY·DEEPSEEK_API_KEY. 이 파일과 섞지 않는다.
