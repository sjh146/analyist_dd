# Runtime state / artifacts (never commit)
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Logs and loop state
*.log
*.out.log
*.err.log
runner.log
bridge.log
loop_state.json
kill_switch.txt

# Journal database: personal trade history + broker account number
journal/*.sqlite3
journal/*.sqlite3-*
journal/*.sqlite3.*
journal/backup_*/
!journal/.gitkeep

# Machine-generated tuning state (regenerated by tools/review.py)
strategy_params.json

# Scratch files used by analysis/diagnostics
tmp_*
*.tmp

# Vendor sample code (Daishin Creon PLUS examples): not ours to redistribute.
# Keep a local copy; exclude it from the repository.
크레온 기본알고리즘/
creon_extracted_v1/

# Runtime artifacts (fills exports, partial-sell side files, loop outputs)
# Nothing under these trees is source; they are regenerated by the loop/tools.
data/
reports/

# Credentials, if ever dropped here
*git-token*
*credentials*
.env
.env.*
!.env.example

# generated at register time (tools/register_tasks.ps1)
tools/tasks/*.xml
