# analyist_dd 운영 크론 (프로덕션 재현본) — 시각 조정 필요 시 이 파일만 수정
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Asia/Seoul

# 평일 저녁: 일봉 수집 (KIS 있으면 KIS, 없으면 KRX OpenAPI)
55 18 * * 1-5 root /home/jhshi/cron/daily_bars.sh >> /home/dduckbeagy/analyist_dd/reports/cron_kis_daily.log 2>&1
# 평일 저녁: 종합 파이프라인 (수집→ML→스윙→백테스트→전략)
0 20 * * 1-5 root /home/jhshi/cron/evening_pipeline.sh >> /home/dduckbeagy/analyist_dd/reports/cron_evening_pipeline.log 2>&1
# 평일 밤: 당일 분봉 수집
0 23 * * 1-5 root /home/jhshi/cron/kis_minute.sh >> /home/dduckbeagy/analyist_dd/reports/cron_kis_minute.log 2>&1
# 평일 새벽: 일봉 공실 백필 1일/회 — KIS 키 없으면 KRX 경로로 자동 전환
15 4 * * 2-6 root /home/jhshi/cron/data_gap_backfill.sh >> /home/dduckbeagy/analyist_dd/reports/cron_data_gap_backfill.log 2>&1
50 7 * * 1-5 root /home/jhshi/cron/data_gap_report.sh >> /home/dduckbeagy/analyist_dd/reports/cron_data_gap_report.log 2>&1
# 평일 아침: 스윙 파이프라인 (레포 config/cron 원본과 동일)
30 8 * * 1-5 root /home/jhshi/cron/swing_pipeline.sh >> /home/dduckbeagy/analyist_dd/.omo/evidence/cron-swing-pipeline.log 2>&1
# 뉴스/감성 데이터 2일 초과분 정리
30 3 * * * root /home/jhshi/cron/news_cleanup.sh >> /home/dduckbeagy/analyist_dd/reports/cron_news_cleanup.log 2>&1

# 평일 08:40 — 스윙 피드 발행 (08:30 스윙 파이프라인 산출물 기준)
40 8 * * 1-5 root /home/jhshi/cron/feed_publish.sh >> /home/dduckbeagy/analyist_dd/reports/cron_feed_publish.log 2>&1
# 평일 14:40 — 종가 스크리너 잡 + 피드 발행 (진입창 14:50~15:25 전)
40 14 * * 1-5 root /home/jhshi/cron/close_job.sh >> /home/dduckbeagy/analyist_dd/reports/cron_close_job.log 2>&1
# 평일 20:30 — 저녁 파이프라인(20:00) 후 스윙 피드 재발행 (다음날 아침용)
30 20 * * 1-5 root /home/jhshi/cron/feed_publish.sh >> /home/dduckbeagy/analyist_dd/reports/cron_feed_publish.log 2>&1

# --- 2026-09-28 추가: 죽은 수집 경로 대체 (pykrx/KRX_ID 미설정 → OpenAPI + KIS) ---
20 16 * * 1-5 root /home/jhshi/cron/kis_supply.sh >> /home/dduckbeagy/analyist_dd/reports/cron_kis_supply.log 2>&1
30 19 * * 1-5 root /home/jhshi/cron/kis_short_program.sh >> /home/dduckbeagy/analyist_dd/reports/cron_kis_short_program.log 2>&1
40 19 * * 1-5 root /home/jhshi/cron/krx_offline.sh >> /home/dduckbeagy/analyist_dd/reports/cron_krx_offline.log 2>&1
50 19 * * 1-5 root /home/jhshi/cron/macro_daily.sh >> /home/dduckbeagy/analyist_dd/reports/cron_macro_daily.log 2>&1

# --- 2026-10-01 추가 (R25): DART 공시 인덱스(disclosures) 백필 ---
# 09-23 이후 '정기 러너 부재'로 정지했던 경로. 러너가 dq_claim 자기신고를 남긴다.
# daily = 이번 달 창 + 유형 B,D,E,I (실측 12초/5콜) · 토요일 = 3개월 창 누락 안전망.
10 18 * * 1-5 root /home/jhshi/cron/dart_disclosures.sh >> /home/dduckbeagy/analyist_dd/reports/cron_dart_disclosures.log 2>&1
10 18 * * 6 root /home/jhshi/cron/dart_disclosures.sh --regular >> /home/dduckbeagy/analyist_dd/reports/cron_dart_disclosures_regular.log 2>&1

# --- 2026-10-02 추가 (헌장 §6): swing 경로 표본 축적 프로브 ---
# close 경로는 3개월 실측으로 종결(기대값 음수), swing 은 표본 부족으로 판정 보류 →
# 하루 1회 프로브로 청산 표본을 쌓는다(60~70초/회, 읽기 전용).
20 18 * * 1-5 root /home/jhshi/cron/swing_path_probe.sh >> /home/dduckbeagy/analyist_dd/reports/cron_swing_probe.log 2>&1
