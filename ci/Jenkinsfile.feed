pipeline {
  agent any
  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }
  parameters {
    booleanParam(name: 'ALLOW_STALE', defaultValue: false, description: '오래된 피드도 게시(수동 복구용)')
    string(name: 'VERSION', defaultValue: '', description: '코드 번들 버전(X.Y.Z). 비우면 피드만 게시')
  }
  environment {
    REPO = '/work/analyist_dd'
    FEED_REPO = '/work/trader-feed'
    TZ = 'Asia/Seoul'
    STALE_FLAG = "${params.ALLOW_STALE ? '--allow-stale' : ''}"
  }
  stages {
    stage('Validate feed') {
      steps {
        dir("${env.REPO}") {
          sh 'python3 scripts/publish_feed_github.py --dry-run --repo-dir "$FEED_REPO" $STALE_FLAG'
        }
      }
    }
    stage('Publish feed') {
      steps {
        dir("${env.REPO}") {
          sh '''
            set -eu
            git -C "$FEED_REPO" config user.name "analyist_dd bot"
            git -C "$FEED_REPO" config user.email "bot@sjh146.local"
            git -C "$FEED_REPO" remote set-url origin "https://x-access-token:${GH_TOKEN}@github.com/sjh146/trader-feed.git"
            python3 scripts/publish_feed_github.py --repo-dir "$FEED_REPO" $STALE_FLAG
            git -C "$FEED_REPO" log --oneline -1
          '''
        }
      }
    }
    stage('Publish code') {
      when { expression { params.VERSION?.trim() } }
      steps {
        dir("${env.REPO}") {
          sh '''
            set -eu
            git -C "$FEED_REPO" config user.name "analyist_dd bot"
            git -C "$FEED_REPO" config user.email "bot@sjh146.local"
            git -C "$FEED_REPO" remote set-url origin "https://x-access-token:${GH_TOKEN}@github.com/sjh146/trader-feed.git"
            python3 scripts/publish_code_github.py --repo-dir "$FEED_REPO" --version "$VERSION"
            git -C "$FEED_REPO" log --oneline -1
          '''
        }
      }
    }
    stage('Summary') {
      steps {
        dir("${env.FEED_REPO}") {
          sh '''
            python3 - <<"PY"
import json, os
meta = json.load(open("deploy/meta.json"))
print("feed published:", meta["published_at"], "candidates:", meta["candidates"])
ver = "app/VERSION"
print("code version:", open(ver).read().strip() if os.path.isfile(ver) else "none")
PY
          '''
        }
      }
    }
  }
  post {
    always {
      dir("${env.FEED_REPO}") {
        sh '''
          git remote set-url origin https://github.com/sjh146/trader-feed.git || true
        '''
      }
    }
    failure {
      echo '게시 실패 — 고객 PC 는 fail-closed 로 거래하지 않는다.'
    }
  }
}
